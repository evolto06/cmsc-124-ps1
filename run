#!/usr/bin/env bash
# run: Execute one case file for the test harness.
#
# DT_BUILD_DIR selects the sanitizer build when check.sh sets it.
# The default directory is ./build.
binary="${DT_BUILD_DIR:-./build}/cmsc-124-ps1"
if [[ -f "$binary.exe" ]]; then
  binary="$binary.exe"
fi
exec "$binary" "$@"
